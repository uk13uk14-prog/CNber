# 本机 HBuilder 模拟器可用 127.0.0.1；真机请改为电脑局域网 IPv4，例如：
# UNI_APP_API_BASE_URL=http://192.168.1.187:3100/api
UNI_APP_API_BASE_URL=http://127.0.0.1:3100/api

# H5 / Mobile Preview（公网）：三端统一优先读 VITE_CNBER_API_BASE_URL
# 禁止填 192.168.x / 127.0.0.1 / localhost；未设置则 API_PUBLIC_BLOCKED
# VITE_CNBER_API_BASE_URL=https://api.example.com/api
# UNI_APP_API_BASE_URL=https://api.example.com/api
# VITE_API_BASE_URL=https://api.example.com/api
