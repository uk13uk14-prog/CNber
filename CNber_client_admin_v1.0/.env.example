# 本机 HBuilder 模拟器可用 127.0.0.1；真机请改为电脑局域网 IPv4，例如：
# UNI_APP_API_BASE_URL=http://192.168.1.187:3100/api
UNI_APP_API_BASE_URL=http://127.0.0.1:3100/api

# H5 Preview（公网）：禁止填局域网 / localhost；未设置则 API_PUBLIC_BLOCKED
# UNI_APP_API_BASE_URL=https://api.example.com/api
# VITE_API_BASE_URL=https://api.example.com/api
