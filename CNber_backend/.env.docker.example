# Copy to CNber_backend/.env.docker on M1 (never commit real secrets).
# Used by docker compose env_file.

NODE_ENV=production
PORT=3100

# REQUIRED — strong random secret (same as current M1 .env if rotating carefully)
JWT_SECRET=replace-with-current-or-new-strong-secret

# Docker service DNS (inside compose network). Do NOT use 127.0.0.1/localhost here.
MONGO_URL=mongodb://mongo-cnber:27017/cnber
MONGO_URI=mongodb://mongo-cnber:27017/cnber

# Externally reachable root for payment proof absolute URLs.
# Keep as config entry; set to current M1 LAN/Tailscale/public URL when known.
# Examples (do not hardcode blindly):
# PUBLIC_BASE_URL=http://100.97.210.107:3100
# PUBLIC_BASE_URL=http://192.168.x.x:3100
PUBLIC_BASE_URL=

# Comma-separated origins for NODE_ENV=production CORS
CORS_ORIGINS=

IDEAL_POSTCODES_API_KEY=
