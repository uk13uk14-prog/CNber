# Copy to CNber_backend/.env.docker on M1 (never commit real secrets).
# Used by docker compose env_file. .env.docker is gitignored via `.env.*`.

NODE_ENV=production
PORT=3100

# REQUIRED — copy from current M1 Backend .env / PM2 env (do not invent)
JWT_SECRET=replace-with-current-or-new-strong-secret

# -----------------------------------------------------------------------------
# Phase 1 TEMP backend (docker-compose.backend-only.yml)
# Reach existing mongo-cnber via Docker Desktop host gateway.
# Do NOT use 127.0.0.1, localhost, or container IP 172.17.0.2 here.
# Compose also forces this URL in `environment:` so a stale value cannot win.
# -----------------------------------------------------------------------------
MONGO_URL=mongodb://host.docker.internal:27017/cnber
MONGO_URI=mongodb://host.docker.internal:27017/cnber

# Phase 2+ (NOT NOW): only after user-defined network joins mongo + backend:
# MONGO_URL=mongodb://mongo-cnber:27017/cnber
# MONGO_URI=mongodb://mongo-cnber:27017/cnber

# Externally reachable root for payment proof absolute URLs.
# Keep as config entry; set to current M1 LAN/Tailscale URL used by apps.
# Do NOT invent a formal public domain here.
# For TEMP A/B on 13100 you may temporarily point at:
# PUBLIC_BASE_URL=http://127.0.0.1:13100
# Or keep the same public/LAN base as PM2 if clients must open uploaded URLs.
PUBLIC_BASE_URL=
# Optional alias (same meaning). Prefer PUBLIC_BASE_URL if both are set.
APP_PUBLIC_BASE_URL=

# Comma-separated origins for NODE_ENV=production CORS (copy from M1 .env)
CORS_ORIGINS=

# Copy from M1 .env if address lookup is used
IDEAL_POSTCODES_API_KEY=
