PORT=3100
JWT_SECRET=replace-with-a-strong-random-secret
MONGO_URL=mongodb://127.0.0.1:27017/cnber
# 与 MONGO_URL 等价，任选其一
MONGO_URI=mongodb://127.0.0.1:27017/cnber
# 付款凭证等对外可访问根 URL（真机/管理端跨设备打开截图必填，勿用 127.0.0.1）
PUBLIC_BASE_URL=http://localhost:3100
# 生产环境 CORS 白名单，逗号分隔；开发环境 (NODE_ENV!=production) 允许全部来源
CORS_ORIGINS=
IDEAL_POSTCODES_API_KEY=replace-with-ideal-postcodes-api-key
